# ==============================================================================
# CONFIGURACIÓN DEL CONTENEDOR STANDALONE METATRADER 5
# ==============================================================================

# Nombre del contenedor
CONTAINER_NAME=mt5-standalone

# ------------------------------------------------------------------------------
# 1. ACCESO WEB AL ESCRITORIO REMOTO (KASMVNC / GUI DE METATRADER 5)
# ------------------------------------------------------------------------------
# Acceso directo desde tu navegador a http://localhost:3000
CUSTOM_USER=admin
PASSWORD=admin1234
VNC_PORT=3000

# Permisos de usuario (ajustar con `id -u` e `id -g` en Linux si es necesario)
PUID=1000
PGID=1000
TZ=UTC

# Nivel de logs de Wine (evitar spam en logs de Docker)
WINEDEBUG=-all,err-toolbar,fixme-all

# ------------------------------------------------------------------------------
# 2. CREDENCIALES DEL BROKER DE METATRADER 5
# ------------------------------------------------------------------------------
# Variables consumidas por tu script/bot en Python mediante os.getenv(...)
MT5_LOGIN=12345678
MT5_PASSWORD=TuPasswordAqui
MT5_SERVER=MetaQuotes-Demo
MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# ------------------------------------------------------------------------------
# 3. CONFIGURACIÓN DE TU NUEVO PROYECTO PERSONALIZADO
# ------------------------------------------------------------------------------
# Monta tu código en el directorio ./custom_app
# Si tienes un ./custom_app/requirements.txt, se instalará automáticamente en Wine Python al iniciar el contenedor.

# Ejecutar tu script personalizado en Wine Python al arrancar el contenedor
# Especifica la ruta absoluta dentro del contenedor, por ejemplo: /custom_app/main.py
CUSTOM_SCRIPT=/custom_app/main.py

# Alternativa: Ejecutar un comando custom completo (si se define, tiene prioridad sobre CUSTOM_SCRIPT)
# Ejemplo: CUSTOM_COMMAND=wine python /custom_app/bot.py --mode=live
CUSTOM_COMMAND=

# Puerto expuesto para tu propio proyecto (si levanta FastAPI, Flask, aiohttp, etc.)
CUSTOM_APP_PORT=8000

# Desactivar o activar la API Flask original del repositorio base (true / false)
# Por defecto false para que no interfiera con tu propio proyecto
ENABLE_FLASK_API=false
MT5_API_PORT=5001
